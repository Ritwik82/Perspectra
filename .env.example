# Ollama endpoint. The app calls this server-side from /api/analyze.
OLLAMA_URL=http://localhost:11434

# Model tag. gemma4:e2b is 4.6B params, Q4_K_M, supports vision.
OLLAMA_MODEL=gemma4:e2b

# Context window. Do not lower this.
# The system prompt alone is ~5,900 tokens. At 8192 the output is silently
# truncated mid-report. 16384 completes with headroom.
OLLAMA_NUM_CTX=16384

# Model thinking. Leave unset for demo speed (~10 s per analysis).
# Set to 1 to let the model reason first: ~4x slower (~40 s), same verdicts.
# OLLAMA_THINK=1
